# Copy this file to ".env" and fill in your own MongoDB connection string.
#  - Local MongoDB: mongodb://127.0.0.1:27017/mini-trello
#  - MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mini-trello
MONGODB_URI=mongodb://127.0.0.1:27017/mini-trello

# Optional: override the default port (5000)
# PORT=5000
